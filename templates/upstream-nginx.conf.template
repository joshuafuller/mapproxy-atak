log_format upstream_json escape=json
    '{"time":"$time_iso8601","method":"$request_method","uri":"$uri",'
    '"status":$status,"bytes":$body_bytes_sent,'
    '"cache":"$upstream_cache_status",'
    '"upstream_status":"$upstream_status",'
    '"upstream_bytes":"$upstream_response_length",'
    '"request_time":$request_time}';

proxy_cache_path /var/lib/nginx/osm
    levels=1:2
    keys_zone=osm_tiles:16m
    max_size=10g
    inactive=90d
    use_temp_path=off;

server {
    listen 8080;
    server_name _;
    access_log /dev/stdout upstream_json;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # This endpoint is private to the Compose network. It preserves OSM's
    # caching headers and conditionally revalidates stale responses with ETag
    # or Last-Modified instead of blindly downloading the image again.
    location ~ ^/tiles/([0-9]+)/([0-9]+)/([0-9]+)\.png$ {
        rewrite ^/tiles/(.*)$ /$1 break;
        proxy_pass https://tile.openstreetmap.org;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name tile.openstreetmap.org;
        proxy_set_header Host tile.openstreetmap.org;
        proxy_set_header Connection "";
        proxy_set_header User-Agent "__OSM_USER_AGENT__";

        proxy_cache osm_tiles;
        proxy_cache_key "https://tile.openstreetmap.org$uri";
        proxy_cache_lock on;
        proxy_cache_revalidate on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;

        # Upstream Cache-Control/Expires takes precedence. This is the fallback
        # only when a successful tile response supplies no freshness metadata.
        proxy_cache_valid 200 7d;

        add_header X-Upstream-Cache $upstream_cache_status always;
    }
}
